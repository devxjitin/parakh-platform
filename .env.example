# Copy this file to .env, fill it in, then run: docker compose up -d
# Never commit .env (it holds your Resend API key).
#
# Real emails through Resend (https://resend.com):
#   1. Create an API key (Sending access) and put it in SMTP_PASS.
#   2. Add and verify your domain in Resend (DNS records), then use an address on it in SMTP_FROM.
#      Without a verified domain Resend only allows onboarding@resend.dev, and only to your own email.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Parakh <no-reply@parakh.nandivex.in>
