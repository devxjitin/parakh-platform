# Copy to .env for local development. Replace the example secrets for any shared environment.
# For staging and production, runtime settings and secrets come from AWS SSM Parameter Store.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://parakh:parakh@localhost:5432/parakh
WEB_ORIGIN=http://localhost:3000
# The marketing website (its certificate check calls this API from the browser)
WEBSITE_ORIGIN=http://localhost:3100

# Auth and signing. Use at least 32 characters for each secret.
JWT_ACCESS_SECRET=local-example-access-secret-change-me
OTP_SECRET=local-example-otp-secret-change-me
# Required in production, including staging where NODE_ENV=production.
# Keep this value stable once bank details or certificates exist.
# DATA_ENCRYPTION_KEY=
# COOKIE_SECURE=false
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
LOGIN_MAX_FAILURES=5
LOCK_MINUTES=15
ACCOUNT_LOCK_FAILURES=20

RATE_LIMIT_IP_PER_MIN=1200
RATE_LIMIT_LOGIN_IP_PER_MIN=600
RATE_LIMIT_REFRESH_IP_PER_MIN=600
RATE_LIMIT_SIGNUP_IP_PER_MIN=120
RATE_LIMIT_LOOKUP_IP_PER_MIN=300

# Mail and files. Production requires SES and an S3 bucket.
AWS_REGION=ap-south-1
# MAIL_TRANSPORT: log (print to console), smtp (any SMTP provider) or ses (AWS).
MAIL_TRANSPORT=log
# For MAIL_TRANSPORT=smtp (Brevo, Zoho, Gmail, Resend and so on):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587          # 587 uses STARTTLS; 465 uses TLS
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@parakh.nandivex.in
SES_FROM_EMAIL=no-reply@parakh.nandivex.in
# SES_CONFIGURATION_SET=
# SES_EVENTS_KEY=  # At least 16 characters when set.
STORAGE_DRIVER=memory
# S3_BUCKET=

# Payment gateway. Set all three Razorpay values to use PAYMENT_PROVIDER=razorpay.
PAYMENT_PROVIDER=fake
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ALLOW_FAKE_PAYMENTS=true  # Staging only when running with NODE_ENV=production.

# Public verification address defaults to WEB_ORIGIN.
# VERIFY_BASE_URL=https://parakh.nandivex.in
CERT_JOBS_POLL=on
RESULTS_JOBS_POLL=on
NOTIFY_JOBS_POLL=on
AUTH_JOBS_POLL=on
SWEEP_JOBS_POLL=on

# Sentry API error reporting (optional).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# Web settings are baked into the static export.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where "Back to home" on the sign-in pages goes: the marketing website
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3100
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_RELEASE=
